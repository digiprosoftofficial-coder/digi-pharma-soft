APP_NAME="SoftoPharma"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://softopharma.digiprosoft.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpanel_dbname
DB_USERNAME=cpanel_dbuser
DB_PASSWORD=

# ---------------------------------------------------------------------------
# SCALE TIERS — pick ONE based on where you host.
#
# TIER A — Shared hosting (cPanel), small load (safe up to a few hundred
#          active users; see docs/DEPLOYMENT.md "Capacity"):
#   SESSION_DRIVER=database
#   CACHE_STORE=database
#   QUEUE_CONNECTION=database   (add cron below) OR sync (simplest, but email
#                                sends inside the request)
#
# TIER B — VPS / cloud with Redis (recommended for thousands of users):
#   SESSION_DRIVER=redis
#   CACHE_STORE=redis
#   QUEUE_CONNECTION=redis      (run a Supervisor worker — see docs/DEPLOYMENT.md)
#
# Cron for TIER A database queue (runs queued email/invites in the background):
#   * * * * * php /path/to/artisan queue:work database --stop-when-empty --max-time=55 >> /dev/null 2>&1
# ---------------------------------------------------------------------------

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Subdomain-only deploy: use the host, or leave null.
SESSION_DOMAIN=softopharma.digiprosoft.com
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# "database" + the cron above runs email/invites in the background (recommended
# even on shared hosting). Use "sync" only for tiny installs. Use "redis" on VPS.
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail.digiprosoft.com
MAIL_PORT=465
MAIL_USERNAME=no-reply@digiprosoft.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@digiprosoft.com"
MAIL_FROM_NAME="${APP_NAME}"

AUTH_EMAIL_VERIFICATION=true
AUTH_REGISTRATION=false

VITE_APP_NAME="${APP_NAME}"

PLATFORM_2FA_REQUIRED=true

SANCTUM_STATEFUL_DOMAINS=softopharma.digiprosoft.com

# Required before Stripe billing webhooks will be accepted.
STRIPE_WEBHOOK_SECRET=

# Gemini Vision — required when any plan enables photo_search
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT=20

